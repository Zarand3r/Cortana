<?xml version="1.0" encoding="UTF-8"?>
<!-- Hardened-runtime entitlements for the notarized Cortana.app.
     allow-jit + allow-unsigned-executable-memory: MLX compiles Metal kernels and
     pyobjc/ctypes use libffi closure trampolines at runtime.
     network.client: 127.0.0.1 chat server + the one-time first-run model download.
     NO disable-library-validation: the release script signs every nested dylib
     inside-out with the same Developer ID, so library validation passes as-is —
     keeping it enabled would open a dylib-hijack surface on an app that holds a
     Screen Recording grant. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
</dict>
</plist>
