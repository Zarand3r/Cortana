[run]
branch = True
source = cortana
omit =
    cortana/__main__.py   # entrypoint shim: `python -m cortana` -> cli.main()

[report]
show_missing = True
skip_covered = False
# Lines that are never meaningfully executable in a hermetic suite.
exclude_also =
    raise NotImplementedError
    @(abc\.)?abstractmethod
    if __name__ == .__main__.:
