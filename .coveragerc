[run]
branch = True
source = cortana
# `python -m cortana` entrypoint shim -> cli.main(); nothing to test.
omit =
    cortana/__main__.py

[report]
show_missing = True
skip_covered = False
# Lines that are never meaningfully executable in a hermetic suite.
exclude_also =
    raise NotImplementedError
    @(abc\.)?abstractmethod
    if __name__ == .__main__.:
